# ============================================================================
#  AnimeVerse — Variables de entorno
#
#  Copia este archivo como `.env.local` y reemplaza los valores por los de tu
#  proyecto de Supabase. `.env.local` está en .gitignore: NUNCA se sube al
#  repositorio.
#
#  Dónde obtener estos valores:
#    Supabase Dashboard > tu proyecto > Project Settings > API
# ============================================================================

# URL del proyecto de Supabase.
# Formato: https://<id-del-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon / publishable key).
# Es segura de exponer en el navegador SIEMPRE que las tablas tengan RLS
# activo, como es el caso aquí: las políticas de `supabase/schema.sql` solo
# permiten SELECT, por lo que con esta clave no se puede escribir nada.
#
# NUNCA pongas aquí la `service_role` key: esa ignora RLS por completo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
